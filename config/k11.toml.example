# k11 configuration: copy to /etc/k11/k11.toml, pass --config, or set
# K11_CONFIG. Search order: --config, $K11_CONFIG, /etc/k11/k11.toml; never
# the working directory, which may be the agent's.

[grpc]
# The dashboard and API. Keep it local: changing the policy needs the token
# in the dashboard URL `k11 daemon --open` and `k11 dashboard` open; reading
# does not.
listen = "127.0.0.1:1100"

[watch]
# `k11 run -- <cmd>` sessions are always recorded. Add binaries to also
# record every tree they start (matched on the kernel's 15-char comm).
# binaries = ["claude", "codex"]
# Every process on the host. Heavy, and deny rules are refused.
# all = false

# [session]
# Where `k11 run` registers. Anyone may connect; each caller can only
# register itself (the kernel vouches for its pid).
# socket = "/run/k11/k11.sock"

[export]
# The durable record: OCSF 1.1.0 JSON Lines. "-" for stdout.
enabled = true
output = "/var/log/k11/ocsf.jsonl"
# Moved to <output>.1 past this size: at most twice this on disk.
# max_mb = 256

# [probe]
# Kernel ring buffer between probe and daemon. Power of two, at least 4.
# Bigger absorbs longer bursts before events are dropped (dropped events
# are counted and logged).
# ring_buffer_kb = 1024
# Lineage-map capacity with watch.all: above the host's peak task count,
# or forks stop being attributed once it fills (logged as lineage_full).
# max_tracked_pids = 131072

# GeoIP enrichment is optional and off unless the databases exist.
# k11 does not ship them: download GeoLite2 City + ASN from MaxMind
# (free account, license forbids redistribution) and point these at them.
# [geoip]
# database = "/usr/share/GeoIP/GeoLite2-City.mmdb"
# asn_database = "/usr/share/GeoIP/GeoLite2-ASN.mmdb"

# Deny rules need the BPF LSM (`k11 check` shows whether it is available).
# A rule covers a path and everything under it, by whole components.
# With enforce = false a matching open is recorded as "audited" and allowed;
# with enforce = true it fails with EPERM and is recorded as "denied".
# [policy]
# enforce = false
# deny_file_paths = ["/home/user/.ssh", "/home/user/.gnupg"]

# Notices tell you as it happens when an agent reaches a host, opens a port
# to other hosts, touches a sensitive file, matches a deny rule or traces a
# process. What you expect can be quiet: hosts as looked up, addresses, paths.
# [notices]
# quiet = ["api.anthropic.com"]

# [store]
# max_events_per_agent = 5000     # raw-log ring per agent; aggregates unaffected
# max_total_events = 50000        # raw-log budget across all agents
# evict_exited_after_secs = 900   # drop fully-exited agent trees after 15 min

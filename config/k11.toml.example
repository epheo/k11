# k11 configuration
# Copy to config/k11.toml or set K11_CONFIG environment variable.
# k11d searches: $K11_CONFIG, /etc/k11/k11.toml, config/k11.toml

[grpc]
# The API is unauthenticated and can toggle enforcement — keep it local.
listen = "127.0.0.1:1100"

[watch]
# Binaries to monitor by process name. Empty list = monitor all (lineage
# still tracked, but deny rules and enforcement require an explicit list).
# binaries = ["claude", "python3", "node"]

# GeoIP enrichment is optional and off unless the databases exist.
# k11 does not ship them: download GeoLite2 City + ASN from MaxMind
# (free account, license forbids redistribution) and point these at them.
# [geoip]
# database = "/usr/share/GeoIP/GeoLite2-City.mmdb"
# asn_database = "/usr/share/GeoIP/GeoLite2-ASN.mmdb"

# [policy]
# enforce = false
# deny_file_paths = ["/home/user/.ssh/", "/home/user/.gnupg/"]

# [export]
# enabled = false
# output = "-"              # OCSF 1.1.0 JSON Lines: "-" for stdout, or a file path

# [store]
# max_events_per_agent = 10000    # raw-log ring per agent; aggregates unaffected
# evict_exited_after_secs = 900   # drop fully-exited agent trees after 15 min

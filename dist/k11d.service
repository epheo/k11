[Unit]
Description=k11 black-box recorder for AI coding agents
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/k11d
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
Environment=K11_CONFIG=/etc/k11/k11.toml

# Kernels before 5.11 charge BPF maps to locked memory.
LimitMEMLOCK=infinity

# Root, with only what the probe needs: BPF and PERFMON to load it,
# SYS_ADMIN to attach the LSM hook and read tracefs, SYS_PTRACE to read
# other users' /proc/<pid>/cwd and fd links when resolving relative paths.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# /var/log/k11 for `export.output`, /run/k11 for the session socket.
LogsDirectory=k11
LogsDirectoryMode=0700
RuntimeDirectory=k11
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target

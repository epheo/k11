[Unit]
Description=k11 Kernel Security Daemon
Documentation=https://github.com/k11-security/k11
After=network.target

[Service]
# Simple, not notify: k11d does not speak sd_notify.
Type=simple
ExecStart=/usr/bin/k11d
Restart=on-failure
RestartSec=5

# Hardening. ProtectSystem needs an exception for the config search path.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no

# Required capabilities for eBPF
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=k11d

# Environment
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=K11_CONFIG=/etc/k11/k11.toml

[Install]
WantedBy=multi-user.target

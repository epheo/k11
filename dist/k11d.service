[Unit]
Description=k11 Kernel Security Daemon
Documentation=https://github.com/k11-security/k11
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/k11d
Restart=on-failure
RestartSec=5

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no

# Required capabilities for eBPF
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN

# Runtime directory for Unix socket
RuntimeDirectory=k11
RuntimeDirectoryMode=0755

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=k11d

# Environment
Environment=K11_LOG_LEVEL=info
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
